{
  "name": "@scripts/prebundle",
  "private": true,
  "version": "2.66.0",
  "main": "./dist/index.js",
  "nx": {
    "targets": {
      "bundle": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/index.js",
          "cwd": "scripts/prebundle"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "dependencyBundles"
        ],
        "outputs": [
          "{workspaceRoot}/packages/toolkit/utils/compiled"
        ]
      }
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "pnpm build && node ./dist/index.js"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@modern-js/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "0.45.0",
    "import-meta-resolve": "^4.2.0",
    "postcss": "^8.5.30",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@types/debug": "4.1.13",
    "@types/fs-extra": "11.0.4",
    "@types/inquirer": "9.0.10",
    "@types/js-yaml": "4.0.9",
    "@types/less": "3.0.8",
    "@types/lodash": "^4.17.26",
    "@types/mime-types": "3.0.1",
    "@types/minimist": "1.2.5",
    "@types/normalize-path": "3.0.2",
    "@types/semver": "7.8.0",
    "@types/signale": "1.4.7",
    "@typescript/typescript6": "^6.0.2",
    "address": "2.0.3",
    "browserslist": "4.29.5",
    "chalk": "6.0.1",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "debug": "^4.4.3",

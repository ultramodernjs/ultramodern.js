+import { describe, expect, it } from 'vitest';
+import { bootstrapStreamedSignalResults } from '../../src/hydration/streamed-signals.js';
+import { earlySignalBootstrapScript } from '../../src/server/early-signals.js';
+import { activateStreamedMarkup } from '../_server-stream.js';
+
+function documentFixture() {
+	const frame = document.createElement('iframe');
+	document.body.append(frame);
+	const ownerDocument = frame.contentDocument!;
+	const container = ownerDocument.createElement('div');
+	ownerDocument.body.append(container);
+	container.innerHTML = earlySignalBootstrapScript();
+	activateStreamedMarkup(container);
+	return {
+		document: ownerDocument,
+		target: ownerDocument.defaultView!,
+		dispose: () => frame.remove(),
+	};
+}
+
+describe('publisher mailbox handoff', () => {
+	it('releases a disposed last lease for a subsequent live attachment', () => {
+		const fixture = documentFixture();
+		try {
+			const options = { document: fixture.document, buildId: 'build', documentId: 'response' };
+			const first = bootstrapStreamedSignalResults(options);
+			first.dispose();
+			const second = bootstrapStreamedSignalResults(options);
+			second.dispose();
+		} finally {
+			fixture.dispose();
+		}
+	});
+	it('never reopens a suspended authority when its last sibling disposes', () => {
+		const fixture = documentFixture();
+		try {
+			const base = { document: fixture.document, buildId: 'build' };
+			const firstOwner = { scopeKey: 'first-owner' };
+			const first = bootstrapStreamedSignalResults({
+				...base,
+				documentId: 'first',
+				signalOwner: firstOwner,
+			});
+			const second = bootstrapStreamedSignalResults({
+				...base,
+				documentId: 'second',
+				signalOwner: { scopeKey: 'second-owner' },
+			});
+			first.suspend();
+			second.dispose();
+			expect(() =>
+				bootstrapStreamedSignalResults({ ...base, documentId: 'first', signalOwner: firstOwner }),
+			).toThrow();
+			first.dispose();
+		} finally {
+			fixture.dispose();
+		}
+	});
+	it('keeps a suspended last lease fenced instead of restoring the early mailbox', () => {
+		const fixture = documentFixture();
+		try {
+			const options = { document: fixture.document, buildId: 'build', documentId: 'response' };
+			const first = bootstrapStreamedSignalResults(options);
+			first.suspend();
+			expect(() => bootstrapStreamedSignalResults(options)).toThrow();
+			first.dispose();
+		} finally {
+			fixture.dispose();
+		}
+	});
+});

+	if (
+		!state ||
+		!state.runtime ||
+		state.retired ||
+		!authority ||
+		authority.released ||
+		authority.buildId !== state.buildId ||
+		!admittedOwner(authority) ||
+		!authority.native.acceptsComponent(component)

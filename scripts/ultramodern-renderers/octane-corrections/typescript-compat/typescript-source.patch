+++ b/packages/octane/src/compiler/text-types-config.js
@@ -0,0 +1,41 @@
+/**
+ * Rewrite only top-level files/include/exclude string entries to name the
+ * virtual TSX files. Keep JSONC syntax and errors intact for TypeScript's own
+ * config parser, including inherited configs and relative paths. This is a
+ * lexical edit, not a second config parser or an evaluator.
+ */
+export function virtualTextTypeConfig(source) {
+	const tokens = /"(?:[^"\\]|\\[\s\S])*"|\/\/[^\r\n]*|\/\*[\s\S]*?\*\/|[{}\[\]:,]|[^\s{}\[\]:,"]+/g;
+	let depth = 0;
+	let key = null;
+	let specs = false;
+	let result = '';
+	let end = 0;
+	let referencesStart = null;
+	let references = '[]';
+	for (const match of source.matchAll(tokens)) {
+		const token = match[0];
+		if (token.startsWith('//') || token.startsWith('/*')) continue;
+		if (token === '{' || token === '[') {
+			specs = depth === 1 && token === '[' && ['files', 'include', 'exclude'].includes(key);
+			if (depth === 1 && token === '[' && key === 'references') referencesStart = match.index;
+			depth++;
+		} else if (token === '}' || token === ']') {
+			depth--;
+			if (depth === 1 && token === ']' && referencesStart !== null) {
+				references = source.slice(referencesStart, match.index + 1);
+				referencesStart = null;
+			}
+			if (depth < 2) specs = false;
+		} else if (token.startsWith('"')) {
+			let value;
+			try { value = JSON.parse(token); } catch { continue; }
+			if (depth === 1) key = value;
+			else if (specs && depth === 2 && value.endsWith('.tsrx')) {
+				result += source.slice(end, match.index) + JSON.stringify(value + '.tsx');
+				end = match.index + token.length;
+			}
+		} else if (token === ',' && depth === 1) key = null;
+	}
+	return { code: result + source.slice(end), references };
+}

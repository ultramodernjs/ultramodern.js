packages:
  - apps/*
  - verticals/*
  - packages/*

{{workspacePackageLinkingYaml}}{{dependencyOverridesYaml}}minimumReleaseAge: 1440
minimumReleaseAgeStrict: true
minimumReleaseAgeIgnoreMissingTime: false
trustPolicy: no-downgrade
trustPolicyIgnoreAfter: 1440
{{compilerTrustExceptionsYaml}}blockExoticSubdeps: true
engineStrict: true
pmOnFail: error
verifyDepsBeforeRun: error
strictDepBuilds: true

peerDependencyRules:
  allowedVersions:
    react: '>=19.0.0'
    '@effect/vitest>effect': '{{effectVersion}}'

allowBuilds:
  '@parcel/watcher': true
  '@swc/core': true
  core-js: true
  esbuild: true
  lefthook: true
  sharp: true
  workerd: true

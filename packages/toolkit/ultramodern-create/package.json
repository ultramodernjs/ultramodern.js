{
  "name": "@modern-js/ultramodern-create",
  "description": "Opinionated UltraModern.js workspace scaffolding and validation tooling.",
  "homepage": "https://github.com/BleedingDev/ultramodern.js#readme",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/toolkit/ultramodern-create"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js",
    "ultramodern.js",
    "effect",
    "tanstack-router",
    "tailwindcss",
    "i18n"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "version": "3.8.3",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/esm-node/index.js",
  "bin": {
    "ultramodern-create": "./bin/run.js",
    "modern-js-ultramodern-create": "./bin/run.js",
    "modern-js-create": "./bin/run.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "ultramodern-workspace": [
        "./dist/types/ultramodern-workspace/public-api.d.ts"
      ],
      "ultramodern-workspace/codesmith": [
        "./dist/types/ultramodern-workspace/codesmith.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "modern:source": "./src/index.ts",
        "import": "./dist/esm-node/index.js",
        "require": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm-node/index.js"
    },
    "./ultramodern-workspace": {
      "types": "./dist/types/ultramodern-workspace/public-api.d.ts",
      "node": {
        "modern:source": "./src/ultramodern-workspace/public-api.ts",
        "import": "./dist/esm-node/ultramodern-workspace/public-api.js",
        "require": "./dist/cjs/ultramodern-workspace/public-api.cjs"
      },
      "default": "./dist/esm-node/ultramodern-workspace/public-api.js"
    },
    "./ultramodern-workspace/codesmith": {
      "types": "./dist/types/ultramodern-workspace/codesmith.d.ts",
      "node": {
        "modern:source": "./src/ultramodern-workspace/codesmith.ts",
        "import": "./dist/esm-node/ultramodern-workspace/codesmith.js",
        "require": "./dist/cjs/ultramodern-workspace/codesmith.cjs"
      },
      "default": "./dist/esm-node/ultramodern-workspace/codesmith.js"
    },
    "./tsconfig": "./templates/tsconfig.base.json"
  },
  "files": [
    "release-cohort.json",
    "template",
    "template-workspace",
    "templates",
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "pnpm clean && rslib build -c rslib.config.mts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "rslib build -c rslib.config.mts -w",
    "start": "node ./dist/esm-node/index.js",
    "test": "pnpm build && rstest",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/app-tools-extensions": "workspace:*",
    "@modern-js/backend-federation-contracts": "workspace:*",
    "@modern-js/codesmith": "2.6.9",
    "@modern-js/i18n-utils": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261012.0-beta",
    "oxfmt": "0.73.0",
    "tsx": "^4.23.15",
    "ultracite": "8.0.1",
    "@modern-js/renderer-core": "workspace:*",
    "@modern-js/renderer-octane": "workspace:*",
    "@modern-js/renderer-solid": "workspace:*",
    "@modern-js/ultramodern-app-tools": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/i18n-integration": "workspace:*",
    "@modern-js/runtime-renderer-extensions": "workspace:*",
    "@modern-js/plugin-i18n": "workspace:*",
    "@modern-js/plugin-tanstack": "workspace:*",
    "@modern-js/plugin-bff-build-extensions": "workspace:*",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "zephyr-rspack-plugin": "1.6.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "tailwindcss": "4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "i18next": "26.4.6",
    "@babel/core": "7.29.7",
    "typescript": "7.0.2",
    "@effect/tsgo": "0.59.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.15",
    "@octanejs/rspack-plugin": "https://github.com/BleedingDev/octane/releases/download/ultramodern-octane-2383d2ab1e70/octanejs-rspack-plugin-0.2.4.tgz",
    "octane": "https://github.com/BleedingDev/octane/releases/download/ultramodern-octane-2383d2ab1e70/octane-0.13.8.tgz",
    "@modern-js/i18n-runtime-extensions": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "js-yaml": "5.5.0",
    "@tsrx/oxc": "0.20.0"
  },
  "publishConfig": {
    "main": "./dist/esm-node/index.js",
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "node": {
          "import": "./dist/esm-node/index.js",
          "require": "./dist/cjs/index.cjs"
        },
        "default": "./dist/esm-node/index.js"
      },
      "./ultramodern-workspace": {
        "types": "./dist/types/ultramodern-workspace/public-api.d.ts",
        "node": {
          "import": "./dist/esm-node/ultramodern-workspace/public-api.js",
          "require": "./dist/cjs/ultramodern-workspace/public-api.cjs"
        },
        "default": "./dist/esm-node/ultramodern-workspace/public-api.js"
      },
      "./ultramodern-workspace/codesmith": {
        "types": "./dist/types/ultramodern-workspace/codesmith.d.ts",
        "node": {
          "import": "./dist/esm-node/ultramodern-workspace/codesmith.js",
          "require": "./dist/cjs/ultramodern-workspace/codesmith.cjs"
        },
        "default": "./dist/esm-node/ultramodern-workspace/codesmith.js"
      },
      "./tsconfig": "./templates/tsconfig.base.json"
    }
  },
  "modern:source": "./src/index.ts"
}

  "devDependencies": {
    "@modern-js/app-tools": "{{version}}",
    "@modern-js/tsconfig": "{{version}}",
    "typescript": "7.0.2",
    "@types/node": "^26.6.6"{{#unless isSubproject}},
    "rstack": "0.9.1"{{/unless}},
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"{{#if isMcp}},
    "ts-node": "^10.9.2"{{/if}}{{#if mf}},

{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "scripts": {
    "dev": "modern dev",
    "build": "modern build",
    "serve": "modern serve"{{#if isMcp}},
    "deploy": "modern deploy"{{/if}}{{#unless isSubproject}},
    "prepare": "rs hooks",
    "check": "rs check",
    "lint": "rs lint",
    "format": "rs fmt"{{/unless}}

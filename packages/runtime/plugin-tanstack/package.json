{
  "name": "@modern-js/plugin-tanstack",
  "description": "TanStack Router integration for Modern.js.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/runtime/plugin-tanstack"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js",
    "tanstack-router"
  ],
  "version": "3.2.0",
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/types/cli/index.d.ts",
  "main": "./dist/cjs/cli/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/cli/index.d.ts",
      "node": {
        "import": "./dist/esm-node/cli/index.mjs",
        "require": "./dist/cjs/cli/index.js"
      },
      "default": "./dist/cjs/cli/index.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/types/cli/index.d.ts",
      "node": {
        "import": "./dist/esm-node/cli/index.mjs",
        "require": "./dist/cjs/cli/index.js"
      },
      "default": "./dist/cjs/cli/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "node": {
        "module": "./dist/esm/runtime/index.mjs"
      },
      "default": "./dist/esm/runtime/index.mjs"
    },
    "./runtime/router": {
      "types": "./dist/types/runtime/router.d.ts",
      "node": {
        "module": "./dist/esm/runtime/router.mjs"
      },
      "default": "./dist/esm/runtime/router.mjs"
    },
    "./runtime/rsc/client": {
      "types": "./dist/types/runtime/rsc/client.d.ts",
      "node": {
        "module": "./dist/esm/runtime/rsc/client.mjs"
      },
      "default": "./dist/esm/runtime/rsc/client.mjs"
    },
    "./runtime/rsc/server": {
      "types": "./dist/types/runtime/rsc/server.d.ts",
      "node": {
        "module": "./dist/esm/runtime/rsc/server.mjs"
      },
      "default": "./dist/esm/runtime/rsc/server.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/cli/index.d.ts"
      ],
      "cli": [
        "./dist/types/cli/index.d.ts"
      ],
      "runtime": [
        "./dist/types/runtime/index.d.ts"
      ],
      "runtime/router": [
        "./dist/types/runtime/router.d.ts"
      ],
      "runtime/rsc/client": [
        "./dist/types/runtime/rsc/client.d.ts"
      ],
      "runtime/rsc/server": [
        "./dist/types/runtime/rsc/server.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "rslib build --watch",
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build",
    "test": "rstest"
  },
  "dependencies": {
    "@modern-js/i18n-runtime-extensions": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/runtime-utils": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/router-core": "1.171.37"
  },
  "peerDependencies": {
    "@modern-js/app-tools": "workspace:^3.11.3",
    "@modern-js/runtime": "workspace:^3.11.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-rspack": "0.1.0"
  },
  "peerDependenciesMeta": {
    "react-server-dom-rspack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/server-utils": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@tanstack/history": "1.162.5",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-rspack": "0.1.0"
  },
  "sideEffects": [
    "./src/runtime/register.ts",
    "./src/runtime/index.tsx",
    "./src/runtime/router.ts",
    "./dist/esm/runtime/register.mjs",
    "./dist/esm/runtime/index.mjs",
    "./dist/esm/runtime/router.mjs",
    "./dist/esm-node/runtime/register.mjs",
    "./dist/esm-node/runtime/index.mjs",
    "./dist/esm-node/runtime/router.mjs",
    "./dist/cjs/runtime/register.js",
    "./dist/cjs/runtime/index.js",
    "./dist/cjs/runtime/router.js"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/cli/index.d.ts"
  },
  "files": [
    "dist",
    "src"
  ]
}

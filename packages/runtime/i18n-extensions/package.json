{
  "name": "@modern-js/i18n-runtime-extensions",
  "description": "Fork-owned UltraModern.js i18n runtime coordination and localized-route extensions.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/bleedingdev/modern.js",
    "directory": "packages/runtime/i18n-extensions"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern.js",
    "i18n"
  ],
  "version": "3.8.3",
  "types": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.mjs"
    },
    "./router-navigation": {
      "types": "./dist/types/router-navigation/index.d.ts",
      "modern:source": "./src/router-navigation/index.ts",
      "node": {
        "import": "./dist/esm-node/router-navigation/index.mjs",
        "require": "./dist/cjs/router-navigation/index.js"
      },
      "default": "./dist/esm/router-navigation/index.mjs"
    },
    "./package.json": "./package.json",
    "./paths": {
      "types": "./dist/types/paths.d.ts",
      "modern:source": "./src/paths.ts",
      "node": {
        "import": "./dist/esm-node/paths.mjs",
        "require": "./dist/cjs/paths.js"
      },
      "default": "./dist/esm/paths.mjs"
    },
    "./urlRewrite": {
      "types": "./dist/types/urlRewrite.d.ts",
      "modern:source": "./src/urlRewrite.ts",
      "node": {
        "import": "./dist/esm-node/urlRewrite.mjs",
        "require": "./dist/cjs/urlRewrite.js"
      },
      "default": "./dist/esm/urlRewrite.mjs"
    },
    "./ssrLanguageHandoff": {
      "types": "./dist/types/ssrLanguageHandoff.d.ts",
      "modern:source": "./src/ssrLanguageHandoff.ts",
      "node": {
        "import": "./dist/esm-node/ssrLanguageHandoff.mjs",
        "require": "./dist/cjs/ssrLanguageHandoff.js"
      },
      "default": "./dist/esm/ssrLanguageHandoff.mjs"
    },
    "./language-sync/controller": {
      "types": "./dist/types/language-sync/controller.d.ts",
      "modern:source": "./src/language-sync/controller.ts",
      "node": {
        "import": "./dist/esm-node/language-sync/controller.mjs",
        "require": "./dist/cjs/language-sync/controller.js"
      },
      "default": "./dist/esm/language-sync/controller.mjs"
    },
    "./request-language": {
      "types": "./dist/types/requestLanguage.d.ts",
      "modern:source": "./src/requestLanguage.ts",
      "node": {
        "import": "./dist/esm-node/requestLanguage.mjs",
        "require": "./dist/cjs/requestLanguage.js"
      },
      "default": "./dist/esm/requestLanguage.mjs"
    },
    "./native": {
      "types": "./dist/types/native.d.ts",
      "modern:source": "./src/native.ts",
      "node": {
        "import": "./dist/esm-node/native.mjs",
        "require": "./dist/cjs/native.js"
      },
      "default": "./dist/esm/native.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ],
      "paths": [
        "./dist/types/paths.d.ts"
      ],
      "router-navigation": [
        "./dist/types/router-navigation/index.d.ts"
      ],
      "urlRewrite": [
        "./dist/types/urlRewrite.d.ts"
      ],
      "ssrLanguageHandoff": [
        "./dist/types/ssrLanguageHandoff.d.ts"
      ],
      "language-sync/controller": [
        "./dist/types/language-sync/controller.d.ts"
      ],
      "request-language": [
        "./dist/types/requestLanguage.d.ts"
      ],
      "native": [
        "./dist/types/native.d.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@modern-js/renderer-core": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/runtime-utils": "workspace:*",
    "i18next-browser-languagedetector": "^8.3.0"
  },
  "peerDependencies": {
    "@modern-js/runtime": "workspace:^3.11.3",
    "react": "^19.3.1",
    "i18next": ">=25.7.4"
  },
  "peerDependenciesMeta": {
    "@modern-js/runtime": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "i18next": "26.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  },
  "files": [
    "dist",
    "src"
  ]
}

{
  "name": "@modern-js/render",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/runtime/render"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.11.3",
  "files": [
    "dist",
    "hook.d.ts"
  ],
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "node ../../../scripts/with-effect-tsrs.mjs --project tsconfig.json --noEmit && rstest"
  },
  "dependencies": {
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-rspack": "0.1.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-rspack": "0.1.0"
  },
  "peerDependenciesMeta": {
    "react-server-dom-rspack": {
      "optional": true
    }
  },
  "exports": {
    "./ssr": {
      "types": "./dist/types/server/ssr/index.d.ts",
      "default": "./dist/esm/ssr.mjs"
    },
    "./rsc": {
      "types": "./dist/types/server/rsc/index.d.ts",
      "workerd": "./dist/esm/rsc.edge.mjs",
      "worker": "./dist/esm/rsc.edge.mjs",
      "edge-light": "./dist/esm/rsc.edge.mjs",
      "default": "./dist/esm/rsc.mjs"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/esm/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "ssr": [
        "./dist/types/server/ssr/index.d.ts"
      ],
      "rsc": [
        "./dist/types/server/rsc/index.d.ts"
      ],
      "client": [
        "./dist/types/client/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}

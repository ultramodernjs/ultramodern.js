{
  "name": "@modern-js/i18n-integration",
  "description": "UltraModern.js localized routing and federated resource integration through native Modern.js i18n plugins.",
  "homepage": "https://bleedingdev.github.io/ultramodern.js/",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/runtime/i18n-integration"
  },
  "license": "MIT",
  "version": "3.8.3",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=26.12.0"
  },
  "types": "./dist/types/cli.d.ts",
  "main": "./dist/cjs/cli.js",
  "exports": {
    ".": {
      "types": "./dist/types/cli.d.ts",
      "modern:source": "./src/cli.ts",
      "node": {
        "import": "./dist/esm-node/cli.mjs",
        "require": "./dist/cjs/cli.js"
      },
      "default": "./dist/cjs/cli.js"
    },
    "./cli": {
      "types": "./dist/types/cli.d.ts",
      "modern:source": "./src/cli.ts",
      "node": {
        "import": "./dist/esm-node/cli.mjs",
        "require": "./dist/cjs/cli.js"
      },
      "default": "./dist/cjs/cli.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "modern:source": "./src/runtime.ts",
      "node": {
        "import": "./dist/esm-node/runtime.mjs",
        "require": "./dist/cjs/runtime.js"
      },
      "default": "./dist/esm/runtime.mjs"
    },
    "./runtime/no-react-i18next": {
      "types": "./dist/types/runtime-no-react-i18next.d.ts",
      "modern:source": "./src/runtime-no-react-i18next.ts",
      "node": {
        "import": "./dist/esm-node/runtime-no-react-i18next.mjs",
        "require": "./dist/cjs/runtime-no-react-i18next.js"
      },
      "default": "./dist/esm/runtime-no-react-i18next.mjs"
    },
    "./federation": {
      "types": "./dist/types/federation/boundary.d.ts",
      "modern:source": "./src/federation/boundary.tsx",
      "node": {
        "import": "./dist/esm-node/federation/boundary.mjs",
        "require": "./dist/cjs/federation/boundary.js"
      },
      "default": "./dist/esm/federation/boundary.mjs"
    },
    "./package.json": "./package.json",
    "./options": {
      "types": "./dist/types/options.d.ts",
      "modern:source": "./src/options.ts",
      "node": {
        "import": "./dist/esm-node/options.mjs",
        "require": "./dist/cjs/options.js"
      },
      "default": "./dist/esm/options.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/cli.d.ts"
      ],
      "cli": [
        "./dist/types/cli.d.ts"
      ],
      "runtime": [
        "./dist/types/runtime.d.ts"
      ],
      "runtime/no-react-i18next": [
        "./dist/types/runtime-no-react-i18next.d.ts"
      ],
      "federation": [
        "./dist/types/federation/boundary.d.ts"
      ],
      "options": [
        "./dist/types/options.d.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "dependencies": {
    "@modern-js/i18n-runtime-extensions": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/plugin-i18n": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*"
  },
  "peerDependencies": {
    "@modern-js/app-tools": "workspace:^3.11.3",
    "@modern-js/runtime": "workspace:^3.11.3",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {},
  "optionalDependencies": {},
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/tsconfig": "workspace:*",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "i18next": "26.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.0.18",
    "typescript": "7.0.2",
    "@modern-js/types": "workspace:*"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/cli.d.ts"
  }
}

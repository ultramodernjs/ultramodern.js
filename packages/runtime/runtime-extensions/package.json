        "modern:source": "./src/request-policy/node.ts",
        "import": "./dist/esm-node/request-policy/node.mjs",
        "require": "./dist/esm-node/request-policy/node.mjs",
        "default": "./dist/esm-node/request-policy/node.mjs"
      }
    },
    "./request-context": {
      "types": "./dist/types/request-policy/requestContext.d.ts",
      "modern:source": "./src/request-policy/requestContext.ts",
      "node": {
        "modern:source": "./src/request-policy/requestContext.ts",
        "import": "./dist/esm-node/request-policy/requestContext.mjs",
        "require": "./dist/esm-node/request-policy/requestContext.mjs",
        "default": "./dist/esm-node/request-policy/requestContext.mjs"
      },
      "import": "./dist/esm/request-policy/requestContext.mjs",
      "require": "./dist/esm/request-policy/requestContext.mjs",
      "default": "./dist/esm/request-policy/requestContext.mjs"
    },
    "./package.json": "./package.json",
    "./router-state-plugin": {
      "types": "./dist/types/routerStatePlugin.d.ts",
      "modern:source": "./src/routerStatePlugin.ts",
      "node": {
        "import": "./dist/esm-node/routerStatePlugin.mjs",
        "require": "./dist/cjs/routerStatePlugin.js"
      },
      "default": "./dist/esm/routerStatePlugin.mjs"
    },
    "./router-provider": {
      "types": "./dist/types/routerProvider.d.ts",
      "modern:source": "./src/routerProvider.ts",
      "node": {
        "import": "./dist/esm-node/routerProvider.mjs",

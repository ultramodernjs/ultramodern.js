        "modern:source": "./src/request-policy/node.ts",
        "import": "./dist/esm-node/request-policy/node.mjs",
        "require": "./dist/esm-node/request-policy/node.mjs",
        "default": "./dist/esm-node/request-policy/node.mjs"

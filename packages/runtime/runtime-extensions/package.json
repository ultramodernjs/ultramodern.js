    "./rsc-disabled/*": {
      "types": "./dist/types/rsc-disabled/*.d.ts",
      "default": "./dist/esm/rsc-disabled/*.mjs"
    },
    "./localised-loader-identity": {
      "types": "./dist/types/localisedLoaderIdentity.d.ts",
      "modern:source": "./src/localisedLoaderIdentity.ts",
      "node": {
        "import": "./dist/esm-node/localisedLoaderIdentity.mjs",
        "require": "./dist/cjs/localisedLoaderIdentity.js"
      },
      "default": "./dist/esm/localisedLoaderIdentity.mjs"
    },
    "./context-extensions": {
      "types": "./dist/types/contextExtensions.d.ts",
      "modern:source": "./src/contextExtensions.ts",
      "node": {
        "import": "./dist/esm-node/contextExtensions.mjs",
        "require": "./dist/cjs/contextExtensions.js"
      },
      "default": "./dist/esm/contextExtensions.mjs"

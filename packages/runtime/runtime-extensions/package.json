      "node": {
        "import": "./dist/esm-node/localisedUrls/index.mjs",
        "require": "./dist/cjs/localisedUrls/index.js"
      },
      "default": "./dist/esm/localisedUrls/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ],
      "node": [
        "./dist/types/node.d.ts",
        "./src/node.ts"
      ],
      "safe-failure": [

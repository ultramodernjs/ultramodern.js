      ],
      "server-config": [
        "./dist/types/server-config/index.d.ts",
        "./src/server-config/index.ts"
      ],
      "router-state": [
        "./dist/types/routerState.d.ts",
        "./src/routerState.ts"
      ],
      "request-policy": [
        "./dist/types/request-policy/browser.d.ts",
        "./src/request-policy/browser.ts"
      ],
      "request-policy/client": [
        "./dist/types/request-policy/browser.d.ts",
        "./src/request-policy/browser.ts"
      ],
      "request-policy/server": [
        "./dist/types/request-policy/node.d.ts",
        "./src/request-policy/node.ts"
      ],
      "request-context": [
        "./dist/types/request-policy/requestContext.d.ts",
        "./src/request-policy/requestContext.ts"
      ],
      "router-state-plugin": [
        "./dist/types/routerStatePlugin.d.ts",

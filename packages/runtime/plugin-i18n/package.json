{
  "name": "@modern-js/plugin-i18n",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/runtime/plugin-i18n"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.11.3",
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/types/cli/index.d.ts",
  "main": "./dist/cjs/cli/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/cli/index.d.ts",
      "node": {
        "import": "./dist/esm-node/cli/index.mjs",
        "require": "./dist/cjs/cli/index.js"
      },
      "default": "./dist/cjs/cli/index.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/types/cli/index.d.ts",
      "node": {
        "import": "./dist/esm-node/cli/index.mjs",
        "require": "./dist/cjs/cli/index.js"
      },
      "default": "./dist/cjs/cli/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "node": {
        "module": "./dist/esm/runtime/index.mjs"
      },
      "default": "./dist/esm/runtime/index.mjs"
    },
    "./runtime/consumer": {
      "types": "./dist/types/runtime/context.d.ts",
      "node": {
        "module": "./dist/esm/runtime/context.mjs"
      },
      "default": "./dist/esm/runtime/context.mjs"
    },
    "./runtime/contexts": {
      "types": "./dist/types/runtime/contexts.d.ts",
      "node": {
        "module": "./dist/esm/runtime/contexts.mjs"
      },
      "default": "./dist/esm/runtime/contexts.mjs"
    },
    "./runtime/no-react-i18next": {
      "types": "./dist/types/runtime/no-react-i18next.d.ts",
      "node": {
        "module": "./dist/esm/runtime/no-react-i18next.mjs"
      },
      "default": "./dist/esm/runtime/no-react-i18next.mjs"
    },
    "./runtime/no-react-i18next/consumer": {
      "types": "./dist/types/runtime/context.d.ts",
      "node": {
        "module": "./dist/esm/runtime/context.mjs"
      },
      "default": "./dist/esm/runtime/context.mjs"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "node": {
        "import": "./dist/esm-node/server/index.mjs",
        "require": "./dist/cjs/server/index.js"
      },
      "default": "./dist/cjs/server/index.js"
    },
    "./i18n": {
      "types": "./dist/types/runtime/i18n/index.d.ts",
      "default": "./dist/esm/runtime/i18n/index.mjs"
    },
    "./config": {
      "types": "./dist/types/shared/utils.d.ts",
      "modern:source": "./src/shared/utils.ts",
      "node": {
        "import": "./dist/esm-node/shared/utils.mjs",
        "require": "./dist/cjs/shared/utils.js"
      },
      "default": "./dist/esm/shared/utils.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/cli/index.d.ts"
      ],
      "cli": [
        "./dist/types/cli/index.d.ts"
      ],
      "runtime": [
        "./dist/types/runtime/index.d.ts"
      ],
      "runtime/consumer": [
        "./dist/types/runtime/context.d.ts"
      ],
      "runtime/contexts": [
        "./dist/types/runtime/contexts.d.ts"
      ],
      "runtime/no-react-i18next": [
        "./dist/types/runtime/no-react-i18next.d.ts"
      ],
      "runtime/no-react-i18next/consumer": [
        "./dist/types/runtime/context.d.ts"
      ],
      "server": [
        "./dist/types/server/index.d.ts"
      ],
      "i18n": [
        "./dist/types/runtime/i18n/index.d.ts"
      ],
      "config": [
        "./dist/types/shared/utils.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "rslib build --watch",
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build",
    "test": "rstest"
  },
  "dependencies": {
    "@modern-js/i18n-runtime-extensions": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/runtime-utils": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-runtime": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-chained-backend": "^5.0.6",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-backend": "^4.0.9",
    "i18next-http-middleware": "^3.10.0"
  },
  "peerDependencies": {
    "@modern-js/runtime": "workspace:^3.11.3",
    "i18next": ">=25.10.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": ">=15.7.4"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "i18next": "26.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.0.18",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/cli/index.d.ts"
  },
  "files": [
    "dist",
    "src"
  ]
}

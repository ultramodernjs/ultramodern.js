{
  "name": "@modern-js/bff-effect",
  "description": "Fork-owned Effect runtime, client, edge dispatcher, and data-platform primitives for UltraModern.js BFFs.",
  "homepage": "https://github.com/BleedingDev/ultramodern.js#readme",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/server/bff-effect"
  },
  "license": "MIT",
  "keywords": [
    "effect",
    "bff",
    "framework",
    "modern.js",
    "ultramodern.js"
  ],
  "version": "3.8.3",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "imports": {
    "#effect-entry-shape-registry": {
      "types": "./src/effect/entry-shape-registry.d.cts",
      "default": "./src/effect/entry-shape-registry.cjs"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": "./dist/esm-node/index.mjs",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/cjs/index.js"
    },
    "./effect": {
      "types": "./dist/types/effect/index.d.ts",
      "modern:source": "./src/effect/index.ts",
      "node": "./dist/esm-node/effect/index.mjs",
      "import": "./dist/esm/effect/index.mjs",
      "default": "./dist/cjs/effect/index.js"
    },
    "./context": {
      "types": "./dist/types/effect/context.d.ts",
      "modern:source": "./src/effect/context.ts",
      "node": "./dist/esm-node/effect/context.mjs",
      "import": "./dist/esm/effect/context.mjs",
      "default": "./dist/cjs/effect/context.js"
    },
    "./effect-edge": {
      "types": "./dist/types/effect/edge.d.ts",
      "modern:source": "./src/effect/edge.ts",
      "node": "./dist/esm-node/effect/edge.mjs",
      "import": "./dist/esm/effect/edge.mjs",
      "default": "./dist/esm/effect/edge.mjs"
    },
    "./effect-client": {
      "types": "./dist/types/effect-client/index.d.ts",
      "modern:source": "./src/effect-client/index.ts",
      "node": "./dist/esm-node/effect-client/index.mjs",
      "import": "./dist/esm/effect-client/index.mjs",
      "default": "./dist/esm/effect-client/index.mjs"
    },
    "./microvertical-api": {
      "types": "./dist/types/microvertical-api.d.ts",
      "modern:source": "./src/microvertical-api.ts",
      "node": "./dist/esm-node/microvertical-api.mjs",
      "import": "./dist/esm/microvertical-api.mjs",
      "default": "./dist/esm/microvertical-api.mjs"
    },
    "./data-platform": {
      "types": "./dist/types/data-platform/index.d.ts",
      "modern:source": "./src/data-platform/index.ts",
      "node": "./dist/esm-node/data-platform/index.mjs",
      "import": "./dist/esm/data-platform/index.mjs",
      "default": "./dist/esm/data-platform/index.mjs"
    },
    "./assembly": {
      "types": "./dist/types/assembly.d.ts",
      "modern:source": "./src/assembly.ts",
      "node": "./dist/esm-node/assembly.mjs",
      "default": "./dist/esm/assembly.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ],
      "effect": [
        "./dist/types/effect/index.d.ts",
        "./src/effect/index.ts"
      ],
      "context": [
        "./dist/types/effect/context.d.ts",
        "./src/effect/context.ts"
      ],
      "effect-edge": [
        "./dist/types/effect/edge.d.ts",
        "./src/effect/edge.ts"
      ],
      "effect-client": [
        "./dist/types/effect-client/index.d.ts",
        "./src/effect-client/index.ts"
      ],
      "microvertical-api": [
        "./dist/types/microvertical-api.d.ts",
        "./src/microvertical-api.ts"
      ],
      "data-platform": [
        "./dist/types/data-platform/index.d.ts",
        "./src/data-platform/index.ts"
      ],
      "assembly": [
        "./dist/types/assembly.d.ts",
        "./src/assembly.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@modern-js/bff-core": "workspace:*",
    "@modern-js/create-request": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/server-runtime-extensions": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "4.0.7",
    "effect": "4.0.7"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.7",
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "effect": "4.0.7",
    "esbuild": "^0.28.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}

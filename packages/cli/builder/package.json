{
  "name": "@modern-js/builder",
  "version": "3.9.3",
  "description": "A builder for Modern.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/cli/builder"
  },
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts"
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "compiled",
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest run",
    "test:watch": "rstest watch"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modern-js/utils": "workspace:*",
    "@rsbuild/core": "2.2.13",
    "@rsbuild/plugin-assets-retry": "2.0.2",
    "@rsbuild/plugin-check-syntax": "2.0.1",
    "@rsbuild/plugin-css-minimizer": "2.0.1",
    "@rsbuild/plugin-less": "2.0.1",
    "@rsbuild/plugin-rem": "1.0.6",
    "@rsbuild/plugin-sass": "2.0.1",
    "@rsbuild/plugin-source-build": "1.0.7",
    "@rsbuild/plugin-type-check": "1.6.1",
    "@rsbuild/plugin-typed-css-modules": "1.2.4",
    "@swc/core": "1.16.18",
    "@swc/helpers": "^0.5.23",
    "autoprefixer": "10.6.1",
    "browserslist": "4.29.5",
    "core-js": "^3.50.0",
    "cssnano": "9.8.0",
    "html-minifier-terser": "^7.2.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.30",
    "postcss-custom-properties": "15.0.4",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-font-variant": "5.0.0",
    "postcss-initial": "4.0.1",
    "postcss-media-minmax": "5.0.0",
    "postcss-nesting": "14.0.3",
    "postcss-page-break": "3.0.4",
    "rspack-manifest-plugin": "5.2.2",
    "sass-embedded": "1.105.1",
    "ts-deepmerge": "8.0.0",
    "typescript": "7.0.2",
    "webpack": "5.112.0"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/lodash": "^4.17.26",
    "react": "^19.3.1",
    "react-server-dom-rspack": "0.1.0",
    "rsbuild-plugin-rsc": "0.1.1",
    "terser": "^5.51.2",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-svgr": "2.0.5"
  },
  "peerDependencies": {
    "react-server-dom-rspack": "0.1.0",
    "rsbuild-plugin-rsc": "0.1.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-svgr": "2.0.5"
  },
  "peerDependenciesMeta": {
    "react-server-dom-rspack": {
      "optional": true
    },
    "rsbuild-plugin-rsc": {
      "optional": true
    },
    "@rsbuild/plugin-react": {
      "optional": true
    },
    "@rsbuild/plugin-svgr": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

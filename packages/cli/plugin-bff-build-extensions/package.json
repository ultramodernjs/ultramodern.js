{
  "homepage": "https://github.com/BleedingDev/ultramodern.js#readme",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "license": "MIT",
  "version": "3.8.3",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "name": "@modern-js/plugin-bff-build-extensions",
  "description": "Fork-owned BFF build lifecycle, instrumentation, and producer SDK composition.",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/cli/plugin-bff-build-extensions"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm-node/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./cross-project": {
      "types": "./dist/types/cross-project.d.ts",
      "modern:source": "./src/cross-project.ts",
      "node": {
        "import": "./dist/esm-node/cross-project.mjs",
        "require": "./dist/cjs/cross-project.js"
      },
      "default": "./dist/cjs/cross-project.js"
    },
    "./package.json": "./package.json",
    "./hono-client-codegen": {
      "types": "./dist/types/hono-client-codegen.d.ts",
      "node": {
        "modern:source": "./src/hono-client-codegen.ts",
        "import": "./dist/esm-node/hono-client-codegen.mjs",
        "require": "./dist/cjs/hono-client-codegen.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "cross-project": [
        "./dist/types/cross-project.d.ts",
        "./src/cross-project.ts"
      ],
      "hono-client-codegen": [
        "./dist/types/hono-client-codegen.d.ts",
        "./src/hono-client-codegen.ts"
      ]
    }
  },
  "dependencies": {
    "@modern-js/bff-core": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/plugin-bff": "workspace:*",
    "@modern-js/plugin-bff-extensions": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/server-runtime-extensions": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/core": "1.16.18"
  },
  "peerDependencies": {
    "@modern-js/app-tools": "workspace:^3.9.3",
    "@effect/opentelemetry": "4.0.7",
    "effect": "4.0.7"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.7",
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/bff-effect": "workspace:*",
    "@modern-js/builder": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/tsconfig": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@rsbuild/core": "2.2.13",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "effect": "4.0.7",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  }
}

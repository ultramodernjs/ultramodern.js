{
  "name": "@modern-js/plugin-bff",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/cli/plugin-bff"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.11.3",
  "types": "./src/cli.ts",
  "main": "./dist/cjs/cli.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/cli.d.ts",
      "node": {
        "import": "./dist/esm-node/cli.mjs",
        "require": "./dist/cjs/cli.js"
      },
      "default": "./dist/cjs/cli.js"
    },
    "./cli": {
      "types": "./dist/types/cli.d.ts",
      "node": {
        "import": "./dist/esm-node/cli.mjs",
        "require": "./dist/cjs/cli.js"
      },
      "default": "./dist/cjs/cli.js"
    },
    "./server-plugin": {
      "types": "./dist/types/server.d.ts",
      "node": {
        "import": "./dist/esm-node/server.mjs",
        "require": "./dist/cjs/server.js"
      },
      "default": "./dist/cjs/server.js"
    },
    "./server": {
      "types": "./dist/types/runtime/hono/index.d.ts",
      "node": {
        "import": "./dist/esm-node/runtime/hono/index.mjs",
        "require": "./dist/cjs/runtime/hono/index.js"
      },
      "default": "./dist/cjs/runtime/hono/index.js"
    },
    "./client": {
      "types": "./dist/types/runtime/create-request/index.d.ts",
      "default": "./dist/esm/runtime/create-request/index.mjs"
    },
    "./cross-project": {
      "types": "./dist/types/utils/crossProjectApiPlugin.d.ts",
      "modern:source": "./src/utils/crossProjectApiPlugin.ts",
      "node": {
        "import": "./dist/esm-node/utils/crossProjectApiPlugin.mjs",
        "require": "./dist/cjs/utils/crossProjectApiPlugin.js"
      },
      "default": "./dist/cjs/utils/crossProjectApiPlugin.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/cli.d.ts"
      ],
      "cli": [
        "./dist/types/cli.d.ts"
      ],
      "server-plugin": [
        "./dist/types/server.d.ts"
      ],
      "server": [
        "./dist/types/runtime/hono/index.d.ts"
      ],
      "client": [
        "./dist/types/runtime/create-request/index.d.ts"
      ],
      "cross-project": [
        "./dist/types/utils/crossProjectApiPlugin.d.ts",
        "./src/utils/crossProjectApiPlugin.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest"
  },
  "dependencies": {
    "@modern-js/bff-core": "workspace:*",
    "@modern-js/create-request": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-utils": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/core": "1.16.21",
    "qs": "^6.16.2",
    "type-is": "^3.0.0"
  },
  "peerDependencies": {
    "@modern-js/app-tools": "workspace:^3.11.3"
  },
  "peerDependenciesMeta": {
    "@modern-js/app-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/bff-runtime": "workspace:*",
    "@modern-js/builder": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@rsbuild/core": "2.3.2",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@types/type-is": "^1.6.7",
    "esbuild": "^0.28.2",
    "memfs": "^4.80.0",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/cli.d.ts"
  }
}

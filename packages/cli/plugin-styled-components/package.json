{
  "name": "@modern-js/plugin-styled-components",
  "description": "A Modern.js plugin for styled-components.",
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.11.3",
  "types": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "export": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "default": "./dist/esm/runtime.mjs"
    }
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build"
  },
  "dependencies": {
    "@rsbuild/plugin-styled-components": "1.7.0",
    "@swc/helpers": "^0.5.23"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@rslib/core": "1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/styled-components": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "styled-components": "^6.6.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/types-esm/index.d.mts",
        "default": "./dist/types/index.d.ts"
      },
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./runtime": {
      "types": {
        "import": "./dist/types-esm/runtime.d.mts",
        "default": "./dist/types/runtime.d.ts"
      },
      "default": "./dist/esm/runtime.mjs"
    },
    "./styled": {
      "types": {
        "import": "./dist/types-esm/styled.d.mts",
        "default": "./dist/types/styled.d.ts"
      },
      "default": "./dist/esm/styled.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "runtime": [
        "./dist/types/runtime.d.ts"
      ],
      "styled": [
        "./dist/types/styled.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src"
  ]
}

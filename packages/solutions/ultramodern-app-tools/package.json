{
  "name": "@modern-js/ultramodern-app-tools",
  "description": "Native UltraModern.js build, preset and release plugin composition.",
  "homepage": "https://bleedingdev.github.io/ultramodern.js/",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/solutions/ultramodern-app-tools"
  },
  "license": "MIT",
  "version": "3.8.3",
  "files": [
    "dist",
    "src",
    "lib",
    "bin"
  ],
  "types": "./dist/types/native-composition/index.d.ts",
  "main": "./dist/cjs/native-composition/index.js",
  "exports": {
    ".": {
      "modern:source": "./src/native-composition/index.ts",
      "import": {
        "types": "./dist/types-esm/native-composition/index.d.mts",
        "default": "./dist/esm-node/native-composition/index.mjs"
      },
      "require": {
        "types": "./dist/types/native-composition/index.d.ts",
        "default": "./dist/cjs/native-composition/index.js"
      },
      "types": "./dist/types/native-composition/index.d.ts"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./react-types": {
      "types": "./lib/react-types.d.ts"
    },
    "./server-plugin": {
      "node": {
        "modern:source": "./src/native-composition/server-plugin.ts",
        "import": {
          "types": "./dist/types-esm/native-composition/server-plugin.d.mts",
          "default": "./dist/esm-node/native-composition/server-plugin.mjs"
        },
        "require": {
          "types": "./dist/types/native-composition/server-plugin.d.ts",
          "default": "./dist/cjs/native-composition/server-plugin.js"
        }
      },
      "types": "./dist/types/native-composition/server-plugin.d.ts"
    },
    "./router-state-runtime": {
      "modern:source": "./src/renderers/react/router-state-runtime.ts",
      "node": {
        "import": {
          "types": "./dist/types-esm/renderers/react/router-state-runtime.d.mts",
          "default": "./dist/esm-node/renderers/react/router-state-runtime.mjs"
        },
        "require": {
          "types": "./dist/types/renderers/react/router-state-runtime.d.ts",
          "default": "./dist/cjs/renderers/react/router-state-runtime.js"
        }
      },
      "default": "./dist/esm/renderers/react/router-state-runtime.mjs",
      "types": "./dist/types-esm/renderers/react/router-state-runtime.d.mts"
    },
    "./router-runtime": {
      "modern:source": "./src/renderers/react/router-runtime.ts",
      "node": {
        "import": {
          "types": "./dist/types-esm/renderers/react/router-runtime.d.mts",
          "default": "./dist/esm-node/renderers/react/router-runtime.mjs"
        },
        "require": {
          "types": "./dist/types/renderers/react/router-runtime.d.ts",
          "default": "./dist/cjs/renderers/react/router-runtime.js"
        }
      },
      "default": "./dist/esm/renderers/react/router-runtime.mjs",
      "types": "./dist/types-esm/renderers/react/router-runtime.d.mts"
    },
    "./cli": {
      "modern:source": "./src/native-composition/cli.ts",
      "import": {
        "types": "./dist/types-esm/native-composition/cli.d.mts",
        "default": "./dist/esm-node/native-composition/cli.mjs"
      },
      "require": {
        "types": "./dist/types/native-composition/cli.d.ts",
        "default": "./dist/cjs/native-composition/cli.js"
      }
    },
    "./rsbuild": {
      "modern:source": "./src/native-composition/rsbuild.ts",
      "import": {
        "types": "./dist/types-esm/native-composition/rsbuild.d.mts",
        "default": "./dist/esm-node/native-composition/rsbuild.mjs"
      },
      "require": {
        "types": "./dist/types/native-composition/rsbuild.d.ts",
        "default": "./dist/cjs/native-composition/rsbuild.js"
      }
    },
    "./native-server-plugin": {
      "node": {
        "modern:source": "./src/native-composition/native-server-plugin.ts",
        "import": {
          "types": "./dist/types-esm/native-composition/native-server-plugin.d.mts",
          "default": "./dist/esm-node/native-composition/native-server-plugin.mjs"
        },
        "require": {
          "types": "./dist/types/native-composition/native-server-plugin.d.ts",
          "default": "./dist/cjs/native-composition/native-server-plugin.js"
        }
      },
      "types": "./dist/types/native-composition/native-server-plugin.d.ts"
    },
    "./config-metadata": {
      "node": {
        "modern:source": "./src/native-composition/config-metadata.ts",
        "import": {
          "types": "./dist/types-esm/native-composition/config-metadata.d.mts",
          "default": "./dist/esm-node/native-composition/config-metadata.mjs"
        },
        "require": {
          "types": "./dist/types/native-composition/config-metadata.d.ts",
          "default": "./dist/cjs/native-composition/config-metadata.js"
        }
      },
      "types": "./dist/types/native-composition/config-metadata.d.ts"
    },
    "./react-composition": {
      "node": {
        "require": "./dist/cjs/renderers/react/composition.js"
      },
      "types": "./dist/types/renderers/react/composition.d.ts"
    },
    "./react-build-metadata-server": {
      "node": {
        "modern:source": "./src/renderers/react/build-metadata-server.ts",
        "import": {
          "types": "./dist/types-esm/renderers/react/build-metadata-server.d.mts",
          "default": "./dist/esm-node/renderers/react/build-metadata-server.mjs"
        },
        "require": {
          "types": "./dist/types/renderers/react/build-metadata-server.d.ts",
          "default": "./dist/cjs/renderers/react/build-metadata-server.js"
        }
      },
      "types": "./dist/types/renderers/react/build-metadata-server.d.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build && pnpm run verify:deploy-output",
    "test": "rstest",
    "verify:deploy-output": "node ./tests/deploy-output/verify-public-surface.mjs"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/app-tools-extensions": "workspace:*",
    "@modern-js/backend-federation-contracts": "workspace:*",
    "@modern-js/builder": "workspace:*",
    "@modern-js/federation-runtime": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/plugin-bff-build-extensions": "workspace:*",
    "@modern-js/renderer-core": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/runtime-utils": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-runtime-extensions": "workspace:*",
    "@modern-js/surface-resolution": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@rsbuild/core": "2.2.13",
    "@types/babel__core": "^7.20.5",
    "prettier": "~3.9.10"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@modern-js/plugin-bff": "workspace:*",
    "@modern-js/plugin-tanstack": "workspace:*",
    "@modern-js/prod-server": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/server": "workspace:*",
    "@modern-js/tsconfig": "workspace:*",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/i18n-integration": "workspace:*",
    "@modern-js/runtime-renderer-extensions": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.15",
    "@octanejs/rspack-plugin": "https://github.com/BleedingDev/octane/releases/download/ultramodern-octane-0bf2313bbdfb/octanejs-rspack-plugin-0.2.4.tgz",
    "octane": "https://github.com/BleedingDev/octane/releases/download/ultramodern-octane-0bf2313bbdfb/octane-0.13.8.tgz",
    "@modern-js/renderer-solid": "workspace:*",
    "@modern-js/renderer-octane": "workspace:*",
    "@rsbuild/plugin-svgr": "2.0.5",
    "@tsrx/oxc": "0.20.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/native-composition/index.d.ts"
  },
  "typesVersions": {
    "*": {
      "types": [
        "./src/types.d.ts"
      ],
      "react-types": [
        "./lib/react-types.d.ts"
      ],
      "server-plugin": [
        "./dist/types/native-composition/server-plugin.d.ts",
        "./src/native-composition/server-plugin.ts"
      ],
      "router-state-runtime": [
        "./dist/types/renderers/react/router-state-runtime.d.ts",
        "./src/renderers/react/router-state-runtime.ts"
      ],
      "router-runtime": [
        "./dist/types/renderers/react/router-runtime.d.ts",
        "./src/renderers/react/router-runtime.ts"
      ],
      "cli": [
        "./dist/types/native-composition/cli.d.ts"
      ],
      "rsbuild": [
        "./dist/types/native-composition/rsbuild.d.ts"
      ],
      "native-server-plugin": [
        "./dist/types/native-composition/native-server-plugin.d.ts"
      ],
      "config-metadata": [
        "./dist/types/native-composition/config-metadata.d.ts"
      ],
      "react-composition": [
        "./dist/types/renderers/react/composition.d.ts"
      ],
      "react-build-metadata-server": [
        "./dist/types/renderers/react/build-metadata-server.d.ts"
      ]
    }
  },
  "bin": {
    "ultramodern": "./bin/ultramodern.mjs"
  },
  "peerDependencies": {
    "typescript": "7.0.2",
    "@modern-js/runtime": "workspace:^3.9.3",
    "@modern-js/i18n-integration": "workspace:^3.8.3",
    "@modern-js/runtime-renderer-extensions": "workspace:^3.8.3",
    "@modern-js/renderer-solid": "workspace:^3.8.3",
    "@modern-js/renderer-octane": "workspace:^3.8.3",
    "@rsbuild/plugin-svgr": "2.0.5"
  },
  "peerDependenciesMeta": {
    "@modern-js/runtime": {
      "optional": true
    },
    "@modern-js/i18n-integration": {
      "optional": true
    },
    "@modern-js/runtime-renderer-extensions": {
      "optional": true
    },
    "@modern-js/renderer-solid": {
      "optional": true
    },
    "@modern-js/renderer-octane": {
      "optional": true
    },
    "@rsbuild/plugin-svgr": {
      "optional": true
    }
  }
}

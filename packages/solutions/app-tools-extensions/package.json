{
  "name": "@modern-js/app-tools-extensions",
  "description": "Fork-owned UltraModern.js app-tools extensions for Cloudflare delivery and release envelopes.",
  "homepage": "https://bleedingdev.github.io/ultramodern.js/",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/solutions/app-tools-extensions"
  },
  "license": "MIT",
  "version": "3.8.3",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./cloudflare": {
      "types": "./dist/types/cloudflare/index.d.ts",
      "modern:source": "./src/cloudflare/index.ts",
      "import": "./dist/esm-node/cloudflare/index.mjs",
      "require": "./dist/cjs/cloudflare/index.js"
    },
    "./cloudflare-builder": {
      "types": "./dist/types/cloudflare-builder.d.ts",
      "modern:source": "./src/cloudflare-builder.ts",
      "import": "./dist/esm-node/cloudflare-builder.mjs",
      "require": "./dist/cjs/cloudflare-builder.js"
    },
    "./cloudflare/*": {
      "types": "./dist/types/cloudflare/*.d.ts",
      "modern:source": "./src/cloudflare/*.ts",
      "import": "./dist/esm-node/cloudflare/*.mjs",
      "require": "./dist/cjs/cloudflare/*.js"
    },
    "./cloudflare-output-contract": {
      "types": "./dist/types/cloudflare-output-contract.d.ts",
      "modern:source": "./src/cloudflare-output-contract.ts",
      "import": "./dist/esm-node/cloudflare-output-contract.mjs",
      "require": "./dist/cjs/cloudflare-output-contract.js"
    },
    "./cloudflare-output-plan": {
      "types": "./dist/types/cloudflare-output-plan.d.ts",
      "modern:source": "./src/cloudflare-output-plan.ts",
      "import": "./dist/esm-node/cloudflare-output-plan.mjs",
      "require": "./dist/cjs/cloudflare-output-plan.js"
    },
    "./cloudflare-output-verifier": {
      "types": "./dist/types/cloudflare-output-verifier/index.d.ts",
      "modern:source": "./src/cloudflare-output-verifier/index.ts",
      "import": "./dist/esm-node/cloudflare-output-verifier/index.mjs",
      "require": "./dist/cjs/cloudflare-output-verifier/index.js"
    },
    "./cloudflare-output-verifier/*": {
      "types": "./dist/types/cloudflare-output-verifier/*.d.ts",
      "modern:source": "./src/cloudflare-output-verifier/*.ts",
      "import": "./dist/esm-node/cloudflare-output-verifier/*.mjs",
      "require": "./dist/cjs/cloudflare-output-verifier/*.js"
    },
    "./internal-effect-discovery": {
      "types": "./dist/types/build-config/internal-effect-discovery.d.ts",

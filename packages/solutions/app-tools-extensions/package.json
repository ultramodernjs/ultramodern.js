    },
    "./config": {
      "types": "./dist/types/config.d.ts",
      "modern:source": "./src/config.ts",
      "import": "./dist/esm-node/config.mjs",
      "require": "./dist/cjs/config.js"
    },
    "./release-envelope": {
      "types": "./dist/types/release-envelope/index.d.ts",
      "modern:source": "./src/release-envelope/index.ts",
      "import": "./dist/esm-node/release-envelope/index.mjs",
      "require": "./dist/cjs/release-envelope/index.js"
    },
    "./release-envelope/*": {
      "types": "./dist/types/release-envelope/*.d.ts",
      "modern:source": "./src/release-envelope/*.ts",
      "import": "./dist/esm-node/release-envelope/*.mjs",
      "require": "./dist/cjs/release-envelope/*.js"
    },
    "./release-envelope/contract": {
      "types": "./dist/types/release-envelope/contract.d.mts",
      "modern:source": "./src/release-envelope/contract.mjs",
      "import": "./dist/esm-node/release-envelope/contract.mjs",
      "require": "./dist/cjs/release-envelope/contract.js"
    },
    "./renderer-build-identity": {
      "types": "./dist/types/renderer-build-identity.d.ts",
      "modern:source": "./src/renderer-build-identity.ts",
      "import": "./dist/esm-node/renderer-build-identity.mjs",
      "require": "./dist/cjs/renderer-build-identity.js"
    },
    "./release-identity": {
      "types": "./dist/types/release-identity.d.ts",
      "modern:source": "./src/release-identity.ts",
      "import": "./dist/esm-node/release-identity.mjs",
      "require": "./dist/cjs/release-identity.js"
    },
    "./native-type-checker": {
      "types": "./dist/types/native-type-checker.d.ts",
      "modern:source": "./src/native-type-checker.ts",
      "import": "./dist/esm-node/native-type-checker.mjs",
      "require": "./dist/cjs/native-type-checker.js"
    },
    "./runtime-package-resolution": {
      "types": "./dist/types/runtime-package-resolution.d.ts",
      "modern:source": "./src/runtime-package-resolution.ts",
      "import": "./dist/esm-node/runtime-package-resolution.mjs",
      "require": "./dist/cjs/runtime-package-resolution.js"
    },
    "./policy-defaults": {
      "types": "./dist/types/policy-defaults.d.ts",
      "modern:source": "./src/policy-defaults.ts",
      "import": "./dist/esm-node/policy-defaults.mjs",
      "require": "./dist/cjs/policy-defaults.js"
    },
    "./build-config/precompress/plugin": {
      "types": "./dist/types/build-config/precompress/plugin.d.ts",
      "modern:source": "./src/build-config/precompress/plugin.ts",
      "import": "./dist/esm-node/build-config/precompress/plugin.mjs",
      "require": "./dist/cjs/build-config/precompress/plugin.js"
    },
    "./backend-federation-build": {
      "types": "./dist/types/backend-federation-build/index.d.ts",
      "modern:source": "./src/backend-federation-build/index.ts",
      "import": "./dist/esm-node/backend-federation-build/index.mjs",
      "require": "./dist/cjs/backend-federation-build/index.js"
    },
    "./deploy-output/plugin": {
      "types": "./dist/types/deploy-output/plugin.d.ts",
      "modern:source": "./src/deploy-output/plugin.ts",
      "import": "./dist/esm-node/deploy-output/plugin.mjs",
      "require": "./dist/cjs/deploy-output/plugin.js"
    },
    "./deploy-output/target": {
      "types": "./dist/types/deploy-output/target.d.ts",
      "modern:source": "./src/deploy-output/target.ts",
      "import": "./dist/esm-node/deploy-output/target.mjs",
      "require": "./dist/cjs/deploy-output/target.js"
    },
    "./deploy-output/trace-files": {
      "types": "./dist/types/deploy-output/trace-files.d.ts",
      "modern:source": "./src/deploy-output/trace-files.ts",
      "import": "./dist/esm-node/deploy-output/trace-files.mjs",
      "require": "./dist/cjs/deploy-output/trace-files.js"
    },
    "./workspace-topology": {
      "types": "./dist/types/workspace-topology.d.ts",
      "modern:source": "./src/workspace-topology.ts",
      "import": "./dist/esm-node/workspace-topology.mjs",
      "require": "./dist/cjs/workspace-topology.js"
    },
    "./module-federation-config": {
      "types": "./dist/types/module-federation-config/index.d.ts",
      "modern:source": "./src/module-federation-config/index.ts",
      "import": "./dist/esm-node/module-federation-config/index.mjs",
      "require": "./dist/cjs/module-federation-config/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/*",
        "./src/*"
      ],
      "build-config/precompress/plugin": [
        "./dist/types/build-config/precompress/plugin.d.ts"
      ],
      "backend-federation-build": [
        "./dist/types/backend-federation-build/index.d.ts"
      ],
      "deploy-output/plugin": [
        "./dist/types/deploy-output/plugin.d.ts"
      ],
      "deploy-output/target": [
        "./dist/types/deploy-output/target.d.ts"
      ],
      "deploy-output/trace-files": [
        "./dist/types/deploy-output/trace-files.d.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "pretest": "pnpm run build",
    "dev": "rslib build --watch",
    "build": "rslib build && pnpm run verify:public-surface",
    "test": "rstest",
    "verify:public-surface": "node ./tests/build-config/verify-public-surface.mjs"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@modern-js/backend-federation-contracts": "workspace:*",
    "@modern-js/builder": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/prod-server": "workspace:*",
    "@modern-js/runtime-utils": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-runtime-extensions": "workspace:*",
    "@modern-js/surface-resolution": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "@vercel/nft": "^1.11.0",
    "compression-webpack-plugin": "^12.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "3.3.1",
    "std-env": "4.3.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "2.2.13",
    "@loadable/component": "5.16.7",
    "@modern-js/runtime-renderer-extensions": "workspace:^3.8.3",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@loadable/component": {
      "optional": true
    },
    "@modern-js/runtime-renderer-extensions": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modern-js/bff-effect": "workspace:*",
    "@modern-js/plugin-bff-extensions": "workspace:*",
    "@modern-js/plugin-data-loader": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@module-federation/modern-js-v3": "2.9.2",
    "@module-federation/runtime-tools": "2.9.2",
    "@rsbuild/core": "2.2.13",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "^26.6.5",
    "core-js": "^3.50.0",
    "effect": "4.0.7",
    "miniflare": "5.20261012.0-beta",
    "ndepe": "^0.1.13",
    "@loadable/component": "5.16.7",
    "@modern-js/runtime-renderer-extensions": "workspace:*",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}

+
+    if (isLiteralCode(branches, fold)) {
+      return { safe: true };
+    }
+
+    const forms = absorbingForms(branches, fold);
+
+    if (forms.once) {
+      return { once: true };
+    }
+
+    const positions = buildPositions(root, fold, budget);
+
+    if (!budget.ambiguous && !hasAmbiguousPaths(positions, budget)) {
+      return { safe: true };
+    }

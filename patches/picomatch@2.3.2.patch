+  const sorted = words.slice().sort();
+  return sorted.every((word, j) => j === 0 || !word.startsWith(sorted[j - 1]));
+};
+
+// A loop over a prefix code or a suffix code reads every text in one way, from
+// the left or from the right, so no two paths consume the same text.

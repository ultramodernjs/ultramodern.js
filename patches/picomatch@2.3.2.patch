+    // The lookahead passes at a non-separator after the input start. A star
+    // that may begin an iteration may also see the input start.
+    return subtract(inner.nodes[1].set, atStart ? SEPARATORS.concat(DOT_CHAR) : SEPARATORS);
+  }

+
+const items = node => (node.type === 'seq' ? node.nodes : [node]);
+
+/**
+ * The branches as words when every item is one literal character, read up to
+ * case folding. Under folding, each character becomes its fold class, keyed
+ * by its lowest unit; classes are equal or disjoint.
+ */
+
+const literalWords = (branches, fold) => {
+  const words = [];
+
+  for (const branch of branches) {
+    let word = '';
+
+    for (const item of items(branch.node)) {
+      if (item.type !== 'char') return;
+      const set = fold(item.set);
+      if (set.length > 3 || set.some(([lo, hi]) => lo !== hi)) return;
+      word += String.fromCharCode(set[0][0]);
+    }
+
+    words.push(word);
+  }
+
+  return words;
+};

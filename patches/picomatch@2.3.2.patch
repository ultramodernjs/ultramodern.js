+    const reduced = withoutRepeatedBranches(source, alternations);
+
+    if (reduced !== source) {
+      const result = analyzeRepetition(reduced, flags);
+      if (result.safe) return { rewrite: { star: `(?:${reduced})*`, plus: `(?:${reduced})+` } };
+      if (result.once) return { rewrite: { star: `(?:${reduced})?`, plus: `(?:${reduced})` } };
+      return result;
+    }
+
+    return rewrite(branches, forms, flags);
+  } catch (err) {
+    if (err instanceof Unmodeled) return { risky: true };
+    throw err;
+  }
+};
+
+module.exports = analyzeRepetition;

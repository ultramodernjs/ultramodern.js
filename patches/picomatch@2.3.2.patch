+ *   `S R` every earlier one. With only prefix or only suffix branches, one
+ *   iteration again matches every concatenation.
+ *
+ * `once` holds when one iteration matches the same text as the loop. Such a
+ * loop is ambiguous, since a text and its repetition both match.
+ */
+
+const absorbingForms = (branches, fold) => {
+  const forms = { once: false, prefix: [], suffix: [], other: [] };
+
+  if (branches.length === 1) {
+    const node = branches[0].node;
+    forms.once = items(node).some((item, k) => absorbs(node, k, [], -1, fold));
+    forms.other.push(branches[0]);
+    return forms;
+  }
+
+  const sets = branches.map(branch => chars(branch.node, fold));
+
+  branches.forEach((branch, index) => {
+    if (absorbs(branch.node, items(branch.node).length - 1, sets, index, fold)) {
+      forms.prefix.push(branch);
+    } else if (absorbs(branch.node, 0, sets, index, fold)) {
+      forms.suffix.push(branch);
+    } else {
+      forms.other.push(branch);
+    }
+  });
+
+  forms.once = forms.other.length === 0 && (forms.prefix.length === 0 || forms.suffix.length === 0);
+  return forms;
+};
+
+/**
+ * Rewrites a loop with prefix or suffix branches as
+ * `(?:suffix)?(?:other)*(?:prefix)?`, where the loop over `other` must
+ * itself be safe. Capturing groups keep their count and order: branches with
+ * groups are not reordered among themselves or repeated in the source.
+ */
+
+const rewrite = (branches, forms, flags) => {
+  const { prefix, suffix, other } = forms;
+  const text = list => list.map(branch => branch.text).join('|');
+  const capture = list => list.some(branch => branch.capture);
+  const order = suffix.concat(other, prefix).filter(branch => branch.capture).map(branch => branches.indexOf(branch));
+
+  if (
+    prefix.length + suffix.length === 0 ||
+    order.some((index, j) => j > 0 && index < order[j - 1]) ||
+    (other.length > 0 && !analyzeRepetition(text(other), flags).safe)
+  ) {
+    return { risky: true };
+  }
+
+  const before = suffix.length > 0 ? `(?:${text(suffix)})` : '';
+  const loop = other.length > 0 ? `(?:${text(other)})` : '';
+  const after = prefix.length > 0 ? `(?:${text(prefix)})` : '';
+  const alternatives = [];
+
+  if (before) alternatives.push(before + (loop && `${loop}*`) + (after && `${after}?`));
+  if (loop) alternatives.push(`${loop}+` + (after && `${after}?`));
+  if (after) alternatives.push(after);
+
+  // The one-or-more form repeats `other` after a suffix and `prefix` after
+  // anything else.
+  const repeated = (before && capture(other)) || (alternatives.length > 1 && capture(prefix));
+
+  return {
+    rewrite: {
+      star: `(?:${before && `${before}?`}${loop && `${loop}*`}${after && `${after}?`})`,
+      plus: repeated ? undefined : `(?:${alternatives.join('|')})`
+    }
+  };
+};
+
+/**
+ * Classifies the loop over the compiled body `source` for the regex `flags`.
+ * Returns `{ safe }`, `{ once }`, `{ rewrite: { star, plus } }` or
+ * `{ risky }`. Cheap certificates come first: a literal code is safe and an
+ * absorbing loop is `once`. Other bodies take the position search, and an
+ * ambiguous body is read again without repeated branches before a rewrite.
+ */
+
+const analyzeRepetition = (source, flags) => {
+  const text = String(flags);
+  const unicode = /[uv]/.test(text);
+
+  // The `v` flag reads classes as set expressions, which are not modeled.
+  if (typeof source !== 'string' || (text.includes('v') && source.includes('['))) {
+    return { risky: true };
+  }

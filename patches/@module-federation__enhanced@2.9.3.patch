+/*
+	MIT License http://www.opensource.org/licenses/mit-license.php
+	Author Sam Chen @chenxsan
+*/
+// Script external syntax is owned here; Webpack exposes no public parser.
+export default function extractUrlAndGlobal(urlAndGlobal: string): [string, string] {
+  const index = urlAndGlobal.indexOf('@');
+  if (index <= 0 || index === urlAndGlobal.length - 1) {
+    throw new Error(`Invalid request "${urlAndGlobal}"`);
+  }
+  return [urlAndGlobal.slice(index + 1), urlAndGlobal.slice(0, index)];
+}

+        const exposedModule = {
+          name: dep.exposedName,
+          module: moduleGraph.getModule(dep),
+          request: dep.userRequest,
+        };
+        modules.push(exposedModule);
+        if (!exposedModule.module) {
+          (missingModules ??= []).push(exposedModule);
+        }

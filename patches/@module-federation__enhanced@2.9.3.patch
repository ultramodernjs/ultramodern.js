+    callback();
+  }
+
+  /**
+   * @param {CodeGenerationContext} context context for code generation
+   * @returns {CodeGenerationResult} result
+   */
+  override codeGeneration({ moduleGraph, chunkGraph, runtimeTemplate }: any) {

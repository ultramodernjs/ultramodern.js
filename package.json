{
  "private": true,
  "name": "modern-js-monorepo",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": "web-infra-dev/modern.js",
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "scripts": {
    "preinstall": "node scripts/ultramodern-node-policy/check-node-version.mjs",
    "setup": "npm run reset && pnpm install",
    "reset": "npx rimraf --glob ./**/node_modules",
    "test:framework": "cd tests && pnpm run test:framework",
    "test:builder": "cd tests && pnpm run test:builder",
    "test:ut": "nx run @scripts/prebundle:bundle && rstest",
    "test:ut:prepared": "node scripts/ci/run-prepared-unit-tests.mjs",
    "test:ut:update": "nx run @scripts/prebundle:bundle && rstest -u",
    "lint:package-json": "cd ./scripts/lint-package-json && pnpm start",
    "prepare-build": "node ./scripts/with-effect-tsrs.mjs nx run-many -t build -p @modern-js/* --exclude=@modern-js/main-doc,@modern-js/module-tools-docs --maxParallel=4",
    "prepare-build:local": "node ./scripts/with-effect-tsrs.mjs nx run-many -t build -p @modern-js/* --exclude=@modern-js/main-doc,@modern-js/module-tools-docs --maxParallel=8",
    "prepare": "husky && node scripts/prepare-effect-compiler.mjs",
    "build:required": "node ./scripts/with-effect-tsrs.mjs nx run-many -t build -p @modern-js/* --exclude=@modern-js/main-doc,@modern-js/module-tools-docs --maxParallel=4 --skipRemoteCache",
    "lint": "biome check",
    "change": "changeset add",
    "bump": "changeset version && pnpm install && oxfmt --write --no-error-on-unmatched-pattern \"packages/**/CHANGELOG.md\"",
    "pre:enter": "changeset pre enter",
    "pre:exit": "changeset pre exit",
    "change-status": "changeset status",
    "gen-release-note": "cd ./scripts/release-note && pnpm start",
    "get-release-version": "cd ./scripts/release-version && pnpm start",
    "release": "npm run check-doc-bundle && pnpm publish --filter ./packages/** --report-summary --ignore-scripts",
    "fix:lockfile": "pnpm install --fix-lockfile",
    "update:lockfile": "pnpm install --lockfile-only",
    "check-changeset": "cd ./scripts/check-changeset && pnpm start",
    "check-dependencies": "node ./scripts/check-dependencies.js",
    "check-overrides": "node ./scripts/check-overrides.mjs",
    "update-codesmith": "cd ./scripts/update-codesmith && pnpm start",
    "sync:skills": "node ./scripts/sync-skills.mjs",
    "update-rspress": "npx taze major --include /rspress/ -w -r -l",
    "update-rsbuild": "npx taze major --include /rsbuild/ -w -r -l",
    "update-nx-cache": "nx reset && npm run prepare-build",
    "gen:docs": "rm -rf doc_output && mkdir doc_output && cp -r ./packages/document/doc_build/* ./doc_output",
    "docs:v2-link": "echo '/v2/*  https://modernjs-v2.netlify.app/:splat  200' >> doc_output/_redirects",
    "build:docs": "pnpm --filter @modern-js/main-doc... build && npm run gen:docs && npm run docs:v2-link",
    "prebuild:main-doc-docs": "nx run @modern-js/main-doc:build",
    "validate:native-compatibility": "node scripts/native-compatibility/run-native-compatibility.mjs",
    "validate:boundary-guards": "node scripts/boundary-guards/check-boundary-violations.js --profile scripts/boundary-guards/profile.json",
    "validate:boundary-divergence": "node scripts/ultramodern-boundary-check/check-fork-import-boundary.js",
    "validate:boundary-check": "node scripts/boundary-guards/check-boundary-violations.js --profile scripts/boundary-guards/profile.json; boundary_status=$?; node scripts/ultramodern-boundary-check/check-fork-import-boundary.js; divergence_status=$?; exit $((boundary_status || divergence_status))",
    "validate:security-workflows": "pnpm --filter @scripts/prebundle start js-yaml && node scripts/security/validate-github-workflows.mjs",
    "validate:mf-contracts": "pnpm --dir tests run test:superapp-contracts",
    "validate:superapp-certification": "node scripts/superapp-certification/run-superapp-certification.js",
    "validate:superapp-certification:smoke": "node scripts/superapp-certification/run-superapp-certification.js --profile smoke",
    "validate:superapp-certification:release": "node scripts/superapp-certification/run-superapp-certification.js --profile release",
    "validate:superapp-certification:nightly": "node scripts/superapp-certification/run-superapp-certification.js --profile nightly",
    "validate:superapp-upstream-drift": "node scripts/superapp-certification/run-superapp-certification.js --profile smoke --drift-only",
    "validate:superapp-readiness-report": "node scripts/superapp-certification/generate-readiness-report.js",
    "ultramodern:prepare-bleedingdev-publish": "node scripts/ultramodern-publish/prepare-bleedingdev-packages.mjs",
    "ultramodern:build-bleedingdev-publish": "node scripts/ultramodern-publish/build-bleedingdev-packages.mjs",
    "ultramodern:source-create-proof": "node scripts/ultramodern-publish/validate-source-create-proof.mjs",
    "ultramodern:renderer-release": "node scripts/ultramodern-renderers/release.mjs",
    "validate:typescript": "node ./scripts/with-effect-tsrs.mjs node scripts/typescript-critical.mjs",
    "test:scripts:after-build": "node --test scripts/__tests__/*.test.mjs scripts/ultramodern-supply/dts-plugin.test.mjs scripts/ultramodern-supply/mf-split-chunks.test.mjs scripts/boundary-guards/__tests__/*.test.js scripts/ultramodern-boundary-check/__tests__/*.test.js scripts/superapp-certification/__tests__/*.test.js scripts/native-compatibility/*.test.mjs scripts/ultramodern-production-readiness/__tests__/built-framework/*.test.js scripts/ultramodern-publish/__tests__/built-framework/*.test.mjs",
    "test:publish-tooling": "node --test scripts/lib/__tests__/*.test.js scripts/ultramodern-publish/__tests__/*.test.js scripts/ultramodern-publish/__tests__/*.test.mjs scripts/ultramodern-production-readiness/__tests__/*.test.js",
    "test:scripts": "pnpm --filter @scripts/prebundle start js-yaml && node --test scripts/__tests__/*.test.mjs scripts/ultramodern-supply/dts-plugin.test.mjs scripts/ultramodern-supply/mf-split-chunks.test.mjs scripts/lib/__tests__/*.test.js scripts/boundary-guards/__tests__/*.test.js scripts/ultramodern-boundary-check/__tests__/*.test.js scripts/superapp-certification/__tests__/*.test.js scripts/ultramodern-publish/__tests__/*.test.js scripts/ultramodern-publish/__tests__/*.test.mjs scripts/ultramodern-production-readiness/__tests__/*.test.js scripts/native-compatibility/*.test.mjs scripts/ultramodern-renderers/*.test.mjs scripts/ultramodern-production-readiness/__tests__/built-framework/*.test.js scripts/ultramodern-publish/__tests__/built-framework/*.test.mjs",
    "check-doc-bundle": "cd ./scripts/check-doc-bundle && pnpm start",
    "test:build-consumers": "pnpm --dir scripts/rslib test && pnpm --filter ultramodern-sandpack-profile-smoke test && node --test scripts/prebundle/ultramodern/packed-utils-consumer.test.mjs",
    "test:build-consumers:release": "pnpm run test:build-consumers && ULTRAMODERN_RELEASE_LANE=1 node scripts/prebundle/ultramodern/packed-runtime-consumer.test.mjs",
    "validate:supply": "node scripts/ultramodern-supply/sync-patches.mjs && node scripts/ultramodern-supply/verify-sidecars.mjs"
  },
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2",
  "lint-staged": {
    "!(*.gen).{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --files-ignore-unknown=true --no-errors-on-unmatched"
    ],
    "**/package.json": [
      "pnpm check-dependencies"
    ]
  },
  "dependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/tsgo": "0.59.0",
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/app-tools-extensions": "workspace:*",
    "@modern-js/tsconfig": "workspace:*",
    "@modern-js/ultramodern-create": "workspace:*",
    "@rstest/core": "0.12.3",
    "@scripts/build": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "check-dependency-version-consistency": "6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "~17.6.0",
    "nx": "^23.3.0",
    "oxfmt": "0.73.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "tsrs": "0.20.0-ts7.1.0-beta"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}

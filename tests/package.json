{
  "private": true,
  "name": "tests",
  "version": "2.66.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node utils/runWithPrerequisites.mjs -- pnpm run test:prepared",
    "test:rstest": "pnpm test:framework && pnpm test:rstest-adapter",
    "test:framework": "node utils/runWithPrerequisites.mjs -- rstest",
    "test:framework:prepared": "node utils/runWithPrerequisites.mjs --prepared -- rstest",
    "test:rstest-adapter": "rstest -c rstest.adapter.config.mts",
    "test:builder": "node utils/runWithPrerequisites.mjs -- pnpm --dir e2e/builder test",
    "test:builder:prepared": "node utils/runWithPrerequisites.mjs --prepared -- pnpm --dir e2e/builder test",
    "test:superapp-contracts": "rstest run -c rstest.superapp-contracts.config.mts",
    "test:ut": "pnpm -w run test:ut",
    "pretest:rstest-adapter": "pnpm --dir integration/rstest/basic-app-rstest-browser exec playwright install chromium",
    "test:utils": "rstest run -c rstest.utils.config.mts",
    "test:prepared": "pnpm test:utils && pnpm test:builder && pnpm test:framework && pnpm test:rstest-adapter"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/plugin-polyfill": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@rstest/core": "0.12.3",
    "@scripts/rstest-config": "workspace:*",
    "@swc/core": "1.16.21",
    "@types/node": "^26.6.5",
    "cross-spawn": "^7.0.6",
    "enhanced-resolve": "5.26.0",
    "fs-extra": "^11.4.1",
    "get-port": "7.2.0",
    "kill-port": "^2.0.1",
    "playwright": "^1.64.1",
    "puppeteer": "^25.14.0",
    "rimraf": "^6.1.3",
    "tree-kill": "^1.2.2",
    "typescript": "7.0.2"
  }
}
